{
  "name": "nell",
  "version": "0.0.0",
  "private": true,
  "description": "Nell — Open Source Instinct. A personal AI agent you text to get things done. Source-available, self-hostable, asks before it acts.",
  "license": "FSL-1.1-Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test && pnpm format:check && pnpm licenses:check",
    "licenses:check": "node scripts/check-licenses.mjs",
    "attacks": "pnpm --filter @nell/evals exec vitest run src/attacks.test.ts --reporter=verbose",
    "browsers:install": "pnpm --filter @nell/browser exec playwright-core install --with-deps chromium",
    "start": "node scripts/start.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

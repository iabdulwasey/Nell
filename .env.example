# ---------------------------------------------------------------------------
# Nell configuration. Copy to .env and fill in. Nothing here is required just
# to build the scaffold; these are the variables the platform will read as the
# trust core and channels are implemented.
# ---------------------------------------------------------------------------

# Postgres — the single stateful dependency. Stores app data, durable-workflow
# state, queues, the monitors table, the audit log, and the vector index.
DATABASE_URL=postgresql://user:password@localhost:5432/nell

# Base64-encoded 32-byte key for the encrypted vault. Generate with:
#   openssl rand -base64 32
# Treat as production key material. In hosted deployments this is wrapped by a
# KMS-managed KEK; for self-host it is the master key — back it up separately.
SECRET_ENCRYPTION_KEY=

# Kernel cloud-browser API key (browser automation). Required for browser tasks.
KERNEL_API_KEY=

# Model gateway credential for inference (the ModelRouter reads this).
MODEL_GATEWAY_API_KEY=

# ---------------------------------------------------------------------------
# Commercial (/ee) features — only needed to run the hosted-service layer.
# Self-hosting the personal agent needs NONE of these.
# ---------------------------------------------------------------------------

# Signed license key that unlocks /ee features. Without it the core runs fully;
# /ee features simply stay disabled (fail-soft).
NELL_LICENSE_KEY=

# Ed25519 public key used to verify a license key's signature locally.
# Ships with the distribution; override only if self-issuing under a commercial
# agreement.
NELL_LICENSE_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Channel credentials (added as each channel is implemented): Telegram bot
# token, WhatsApp Cloud API, iMessage gateway, voice bridge, etc.
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_CLOUD_TOKEN=
